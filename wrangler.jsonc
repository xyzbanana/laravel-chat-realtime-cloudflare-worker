{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laravel-chat-realtime",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOMS", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://hangtruyen.online",
    "LARAVEL_WEBHOOK_URL": "https://hangtruyen.online/api/chat/webhook"
  },
  "observability": { "enabled": true }
}
